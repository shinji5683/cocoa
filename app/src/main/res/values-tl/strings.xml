    <string name="label_telemetry_optin">Lumahok sa pagpapaganda ng app</string>

    <string name="dialog_telemetry_title">🌸 serena Screen Reader Alpha Tulong</string>
    <string name="dialog_telemetry_message">Salamat sa paggamit ng serena Screen Reader Alpha.\n\nPara sa pagpapaganda ng app sa Canary, QPR Beta, at Stable OS channels, nangongolekta kami ng anonymized data na ipinapadala kay Shinji (shinjisakiyama@gmail.com).\n\n[Makukuhang Impormasyon]\n・OS version, API level, Modelo ng Telepono\n・Bilang ng kumpas, Bilang ng wika, Bilang ng tawag\n\n⚠️ Walang personal na impormasyon (numero, mensahe, boses) ang kukunin.\n\nGusto mo bang tumulong sa pagpapaganda ng serena?</string>
    <string name="dialog_telemetry_agree">Pumapayag at Tumutulong</string>
    <string name="dialog_telemetry_refuse">Magpalipas muna</string>

    <string name="title_hourly_chime">Awtomatikong Oras at Chime</string>
    <string name="desc_hourly_chime">Awtomatikong nagsasabi ng oras gamit ang magandang chime tuwing oras.</string>
    <string name="label_hourly_chime_switch">I-on ang Hourly Chime</string>
    <string name="btn_test_hourly_chime">Subukan ang Chime at Boses</string>

    <string name="label_announce_operation_actions">Detalyadong Boses ng Gabay sa Pagkilos (Para sa Nagsisimula)</string>
    <string name="desc_announce_operation_actions">Binabasa ang mga gabay sa pagkilos tulad ng pag-scroll o pag-execute. Kapag naka-off (inirerekomenda), tanging tunog at vibration lang ang maririnig para mas mabilis marinig ang nilalaman.</string>

