    <string name="title_features">Mga Pangunahing Tampok at Kumpas</string>
    <string name="feature_1">・[Lipat ng Pokus] I-swipe ang 1 daliri pakaliwa/pakanang para lumipat</string>
    <string name="feature_2">・[Pindot] I-double tap ang 1 daliri para piliin</string>
    <string name="feature_3">・[Nav Kumpas] Baba-Kaliwa para Bumalik, Taas-Kaliwa para sa Home, Baba-Kanan para sa Notifications</string>
    <string name="feature_4">・[Tawag at Mensahe] Pagtukoy sa tumatawag at tagal ng tawag</string>
