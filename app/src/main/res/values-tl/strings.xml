    <string name="title_telemetry">Alpha Diagnostics at Report</string>
    <string name="desc_telemetry">Nangongolekta ng walang pangalang datos para sa pag-aayos ng mga error at pagpapaganda ng app.</string>
    <string name="btn_send_telemetry">Ipadala ang Report kay Shinji (shinjisakiyama@gmail.com)</string>
