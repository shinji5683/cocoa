<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- ヘッダー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <Button
            android:id="@+id/btnExplainScreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_btn_explain_screen"
            android:contentDescription="@string/chat_btn_explain_screen"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnCloseChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_btn_close"
            android:contentDescription="@string/chat_btn_close"
            android:backgroundTint="#333333"
            android:textColor="#EEEEEE" />
    </LinearLayout>

    <!-- チャットメッセージ履歴リスト -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- AI 思考・応答中ステータス -->
    <TextView
        android:id="@+id/tvChatStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#263238"
        android:textColor="#80D8FF"
        android:textSize="14sp"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

    <!-- 入力エリア -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:hint="@string/chat_hint_input"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575"
            android:background="#2C2C2C"
            android:padding="12dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />

        <Button
            android:id="@+id/btnVoiceInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_btn_voice"
            android:contentDescription="@string/chat_btn_voice"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_btn_send"
            android:contentDescription="@string/chat_btn_send"
            android:backgroundTint="#4285F4"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
