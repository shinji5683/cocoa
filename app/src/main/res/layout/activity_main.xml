<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/serena_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/serena_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="@color/serena_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_label"
                    android:textSize="14sp"
                    android:textColor="@color/serena_text_muted" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disabled"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_red"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnOpenAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_open_accessibility"
                    android:textSize="16sp"
                    android:backgroundTint="@color/serena_primary"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- OS Environment & Security Health Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_security_health"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvSecurityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="診断中..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_text_dark"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSecurityDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="環境を診断しています"
                    android:textColor="@color/serena_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnRecheckSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_recheck_security"
                    android:backgroundTint="@color/serena_secondary"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_permissions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_text_dark"
                    android:layout_marginBottom="12dp" />

                <!-- Overlay Permission -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="他のアプリの上に重ねて表示"
                        android:textColor="@color/serena_text_dark"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_perm_denied"
                        android:textColor="@color/status_red"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRequestOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_request_overlay"
                    android:textSize="14sp"
                    android:backgroundTint="@color/serena_secondary"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    app:cornerRadius="10dp" />

                <!-- Notification Permission -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="通知の受信・アナウンス許可"
                        android:textColor="@color/serena_text_dark"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNotificationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_perm_denied"
                        android:textColor="@color/status_red"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRequestNotification"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_request_notification"
                    android:textSize="14sp"
                    android:backgroundTint="@color/serena_secondary"
                    android:layout_marginTop="6dp"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TTS Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_tts_settings"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_text_dark"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="読み上げ速度: 1.0x"
                    android:textColor="@color/serena_text_dark" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:value="1.0"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/tvPitchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音声ピッチ: 1.0x"
                    android:textColor="@color/serena_text_dark"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:value="1.0"
                    android:stepSize="0.1" />

                <Button
                    android:id="@+id/btnTestSpeech"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_test_speech"
                    android:backgroundTint="@color/serena_secondary"
                    android:layout_marginTop="12dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnOpenTtsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_open_tts_settings"
                    android:backgroundTint="@color/serena_primary"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test Bench Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_test_bench"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_text_dark"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etTestInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/test_edit_hint"
                    android:contentDescription="テスト入力フィールド"
                    android:padding="14dp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnTestA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/test_button_1"
                        android:contentDescription="テストボタンA、押すと確認音を鳴らします"
                        android:layout_marginEnd="6dp"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnTestB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/test_button_2"
                        android:contentDescription="テストボタンB"
                        android:layout_marginStart="6dp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDetailMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/test_switch_label"
                    android:checked="true"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnTriggerMenu"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="☕ serena メニューをテスト開く"
                    android:backgroundTint="@color/serena_primary"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Features Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_features"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_1"
                    android:textColor="@color/serena_text_muted"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_2"
                    android:textColor="@color/serena_text_muted"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_3"
                    android:textColor="@color/serena_text_muted"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feature_4"
                    android:textColor="@color/serena_text_muted" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hourly Chime Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_hourly_chime"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_hourly_chime"
                    android:textColor="@color/serena_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHourlyChime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_hourly_chime_switch"
                    android:textColor="@color/serena_text_dark"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnTestHourlyChime"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_test_hourly_chime"
                    android:backgroundTint="@color/serena_secondary"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alpha Telemetry & Privacy Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_telemetry"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_telemetry"
                    android:textColor="@color/serena_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTelemetryOptIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_telemetry_optin"
                    android:textColor="@color/serena_text_dark"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnSendTelemetry"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_send_telemetry"
                    android:backgroundTint="@color/serena_primary"
                    android:layout_marginBottom="8dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnCopyTelemetry"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_copy_telemetry"
                    android:backgroundTint="@color/serena_secondary"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Developer & Signature Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/serena_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_developer_info"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/serena_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/provider_name_label"
                    android:textColor="@color/serena_text_dark"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/developer_name_label"
                    android:textColor="@color/serena_text_dark"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDeveloperPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/developer_phone_label"
                    android:textColor="@color/serena_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnCallDeveloper"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_call_developer"
                    android:backgroundTint="@color/serena_primary"
                    android:layout_marginBottom="12dp"
                    app:cornerRadius="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/signature_label"
                    android:textColor="@color/status_green"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/copyright_label"
                    android:textColor="@color/serena_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
