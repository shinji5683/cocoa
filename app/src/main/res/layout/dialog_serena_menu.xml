<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FDF8F5"
    android:padding="16dp">

    <!-- Header Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="#5C3A21"
            android:contentDescription="serena シンボルアイコン (🌸 桜・🦯 白杖・🪷 ユリ)" />

        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="🌸 🦯 🪷 serena メニュー"
            android:textColor="#2B1B12"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5D3C5"
        android:layout_marginBottom="8dp" />

    <!-- Scrollable Container for Menu Options (Constrained Height for Auto-Scroll) -->
    <ScrollView
        android:id="@+id/scrollMenuItems"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerMenuItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamic items will be added here -->
        </LinearLayout>
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="閉じる"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5C3A21" />

</LinearLayout>
