    <string name="title_features">Key Features &amp; Gestures</string>
    <string name="feature_1">・[Focus Navigation] Swipe 1-finger left/right to move focus</string>
    <string name="feature_2">・[Click] Double-tap 1-finger to activate focused item</string>
    <string name="feature_3">・[Gesture Nav] Down-Left for Back, Up-Left for Home, Down-Right for Notifications</string>
    <string name="feature_4">・[Calls &amp; Messaging] Caller ID announcement &amp; call duration tracking</string>
