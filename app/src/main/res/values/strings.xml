    <string name="title_telemetry">Alpha Telemetry &amp; Diagnostics</string>
    <string name="desc_telemetry">Collects completely anonymized usage metrics for bug fixes and stability improvements.</string>
    <string name="btn_send_telemetry">Send Report to Developer (shinjisakiyama@gmail.com)</string>
    <string name="btn_copy_telemetry">Copy Report to Clipboard</string>
    <string name="label_telemetry_optin">Participate in diagnostics &amp; improvements</string>

    <string name="dialog_telemetry_title">🌸 serena Screen Reader Alpha Participation</string>
    <string name="dialog_telemetry_message">Thank you for using serena Screen Reader Alpha.\n\nTo improve app quality across Canary, QPR Beta, and Stable OS channels, we collect anonymous usage statistics sent to Shinji (shinjisakiyama@gmail.com).\n\n[Collected Information]\n・OS version, API level, Device model\n・Gesture count, TTS language count, Call announcement count\n\n⚠️ No personal information (phone numbers, contacts, messages, recorded speech) is collected.\n\nWould you like to help improve serena?</string>
    <string name="dialog_telemetry_agree">Agree &amp; Help</string>
    <string name="dialog_telemetry_refuse">Skip for now</string>

    <string name="title_hourly_chime">Hourly Time Announcement</string>
    <string name="desc_hourly_chime">Automatically announces current time with a pleasant chime on every hour.</string>
    <string name="label_hourly_chime_switch">Enable Hourly Chime</string>
    <string name="btn_test_hourly_chime">Test Chime &amp; Voice</string>

    <string name="title_call_settings">Phone &amp; Call Assistant</string>
    <string name="desc_call_settings">Provides voice announcements for caller ID and total duration upon call completion.</string>
    <string name="label_call_periodic_switch">Announce in-call elapsed time every minute</string>
    <string name="desc_call_periodic_switch">Periodically announces call duration every minute during active calls (Default: OFF).</string>

    <string name="label_announce_operation_actions">Detailed Operation Guidance (Beginner Mode)</string>
    <string name="desc_announce_operation_actions">Speaks detailed guidance such as \'Scrolled down\' or \'Executed\'. When OFF (recommended), provides fast, snappy earcon haptics and immediately speaks target content.</string>

